{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@/types/*": ["../src/types/*"],
      "@/data/*": ["../src/data/*"],
      "@/engine/*": ["../src/engine/*"]
    }
  },
  "include": ["src", "../src/types", "../src/data", "../src/engine"],
  "exclude": ["../src/utils"]
}
